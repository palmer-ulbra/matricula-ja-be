  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:reset": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/01-schema.sql -f db/02-seed.sql",
